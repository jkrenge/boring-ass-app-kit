{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "boring-api",
  "main": "src/entry.py",
  "compatibility_date": "2026-11-22",
  "compatibility_flags": ["python_workers"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boring-api",
      // from `uv run pywrangler d1 create boring-api`
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  // per Cloudflare location, approximate; namespace_id just has to be unique in your account
  "ratelimits": [
    { "name": "DEVICE_LIMIT", "namespace_id": "1001", "simple": { "limit": 120, "period": 60 } },
    { "name": "REGISTER_LIMIT", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
